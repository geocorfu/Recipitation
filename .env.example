# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Who may sign in (comma-separated emails). Extra safety on top of Supabase. ---
ALLOWED_EMAILS=you@example.com

# --- Daily keep-alive job ---
# Any long random string. Vercel sends it automatically to the cron route.
CRON_SECRET=change-me-to-a-long-random-string
